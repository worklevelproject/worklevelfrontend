# 백엔드 API 서버 주소 (WorkController, StoreController 등이 떠 있는 곳)
API_BASE_URL=http://localhost:8080

# 로그인 완료 후 백엔드가 "?accessToken=..."을 붙여 리다이렉트해줄 이 프론트의 콜백 주소.
# 백엔드 환경변수 OAUTH2_REDIRECT_URI를 반드시 이 값과 똑같이 맞춰야 한다.
OAUTH2_CALLBACK_URL=http://localhost:5173/auth/callback

# PROTECTED 파일(S3/R2)을 실제로 조회하는 Cloudflare Worker 주소. 백엔드
# POST /s3-files/protected-access가 내려주는 {key, token}을 이 주소 뒤에
# 붙여(`${CDN_BASE_URL}/${key}`) token을 커스텀 헤더 "token"으로 실어 요청한다
# (Authorization 헤더 아님 — Worker가 요청 헤더에서 literal "token" 키로 읽는다).
# Worker는 이 secret으로 HS256 서명을 검증하므로, 백엔드 CDN_SIGN_SECRET 환경변수와
# Worker의 서명 키가 반드시 같은 값이어야 한다.
# 예: https://worklv-nonpublic-worker.example.workers.dev (스킴 https:// 반드시 포함)
CDN_BASE_URL=

# 웹 푸시(FCM) 수신용 Firebase 콘솔 "웹 앱" 설정값. 전부 공개해도 안전한 값들이라(서버 시크릿
# 아님) 프론트 번들에 그대로 노출돼도 문제없다 — Firebase 프로젝트 설정 > 일반 > 내 앱(웹)에서
# 그대로 복사해오면 된다. FIREBASE_VAPID_KEY는 프로젝트 설정 > 클라우드 메시징 > 웹 구성 >
# 웹 푸시 인증서에서 발급받는 별도 키(위 5개와 출처가 다름).
# static/firebase-messaging-sw.js는 서비스워커라 이 .env를 읽을 수 없으므로, 값을 채운 뒤
# 그 파일 상단의 firebaseConfig 객체에도 반드시 동일하게 옮겨 적어야 한다.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=
